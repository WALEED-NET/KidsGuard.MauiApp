<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/danger"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_label"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_desc"
            android:textSize="13sp"
            android:textColor="#FEE2E2"
            android:paddingTop="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <EditText
                    android:id="@+id/emergency_pin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_search"
                    android:hint="@string/pin_hint"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:inputType="numberPassword"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/emergency_release"
                    style="@style/BtnDanger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/release_btn" />

            </LinearLayout>

            <TextView
                android:id="@+id/emergency_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="14dp"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textDirection="ltr"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:text="@string/release_log_empty" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>

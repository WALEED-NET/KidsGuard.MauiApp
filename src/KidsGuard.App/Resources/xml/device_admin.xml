<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-policies>
    <!--
      قائمة مقصودة القصر. لا نطلب <wipe-data> إطلاقاً:
      عدم التصريح بها يعني أنّ التطبيق لا يملك مسح الجهاز حتى لو أُصيب بخلل.
      إعادة ضبط المصنع تبقى بيد المستخدم من الإعدادات — الطبقة السادسة.
    -->
    <force-lock />
  </uses-policies>
</device-admin>
